---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "kip — Secure .env sharing with self-destructing links",
  description = "A CLI that encrypts your secrets, generates a self-destructing link, and shares it in 3 seconds. The server never sees your keys.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Fonts are self-hosted from /public/fonts, not pulled from Google's CDN.
      This layout also wraps /decrypt, which holds a secret's decryption key in
      its URL fragment; that page must not contact a third party at all, and
      SECURITY.md says so. Stylesheets cannot read the fragment, but every
      recipient opening a link would still be announcing it to a CDN.
    -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
