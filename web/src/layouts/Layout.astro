---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * Opt a page in to the analytics tag. Off by default: /decrypt carries a
   * secret's key in its URL fragment and must not load any third-party
   * script, so pages have to ask for analytics rather than opt out of it.
   */
  analytics?: boolean;
}

const {
  title = "kip — Secure .env sharing with self-destructing links",
  description = "A CLI that encrypts your secrets, generates a self-destructing link, and shares it in 3 seconds. The server never sees your keys.",
  analytics = false,
} = Astro.props;

// The tag is only rendered in production builds that set a project id, so a
// local build or a fork without the variable ships no tracking at all.
const tracciaProjectId = import.meta.env.PUBLIC_TRACCIA_PROJECT_ID;
const analyticsEnabled = analytics && import.meta.env.PROD && Boolean(tracciaProjectId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Fonts are self-hosted from /public/fonts, not pulled from Google's CDN.
      This layout also wraps /decrypt, which holds a secret's decryption key in
      its URL fragment; that page must not contact a third party at all, and
      SECURITY.md says so. Stylesheets cannot read the fragment, but every
      recipient opening a link would still be announcing it to a CDN.
    -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      /* async rather than defer: defer scripts execute in order with the
         hydration modules, so a slow analytics host would block the islands. */
      analyticsEnabled && (
        <script
          is:inline
          src="https://traccia-a4qm.onrender.com/t.js"
          data-project={tracciaProjectId}
          data-errors="true"
          async
        />
      )
    }
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
