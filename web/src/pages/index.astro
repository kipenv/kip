---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.vue";
import Hero from "../components/Hero.vue";
import TrustBar from "../components/TrustBar.vue";
import HowItWorks from "../components/HowItWorks.vue";
import Security from "../components/Security.vue";
import Features from "../components/Features.vue";
import Pricing from "../components/Pricing.vue";
import Comparison from "../components/Comparison.vue";
import SelfHost from "../components/SelfHost.vue";
import Faq from "../components/Faq.vue";
import CtaFooter from "../components/CtaFooter.vue";
import Footer from "../components/Footer.vue";
import ThemeToggle from "../components/ThemeToggle.vue";
---

<Layout>
  <Nav client:load />
  <main>
    <Hero client:load />
    <TrustBar client:visible />
    <HowItWorks client:visible />
    <Security client:visible />
    <Features client:visible />
    <Pricing client:visible />
    <Comparison client:visible />
    <SelfHost client:visible />
    <Faq client:visible />
    <CtaFooter client:visible />
  </main>
  <Footer />
  <ThemeToggle client:load />
</Layout>
