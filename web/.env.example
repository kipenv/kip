# Build-time variables for the static site. Astro inlines PUBLIC_* values
# into the client bundle, so nothing here is secret.

# Origin of the kip server the decrypt page fetches ciphertext from.
# Leave empty for same-origin (the single-domain deploy in deploy/).
PUBLIC_API_URL=

# Traccia project id for the landing page analytics. Leave empty to ship
# the site without any analytics tag; it is only rendered in production
# builds and never on the decrypt page.
PUBLIC_TRACCIA_PROJECT_ID=
