# Environment for the self-hosted stack in deploy/.
#
# The server itself is configured with flags (-addr, -redis, -db, -rate-limit),
# not environment variables. What follows is only what the Compose files read.
# Full reference: deploy/ENV.md

# Host port published by deploy/docker-compose.yml (local stack only —
# docker-compose.prod.yml publishes no ports and is routed by a reverse proxy).
PORT=8080

# Requests per minute per IP, passed through to the server's -rate-limit flag.
RATE_LIMIT=30
